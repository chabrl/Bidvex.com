# ─── Database ───
MONGO_URL=mongodb://localhost:27017
DB_NAME=bazario_db

# ─── Authentication ───
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256

# ─── Stripe (Required for billing) ───
STRIPE_API_KEY=sk_live_xxxx                      # Stripe Secret Key
STRIPE_PUBLISHABLE_KEY=pk_live_xxxx              # Stripe Publishable Key (frontend)
STRIPE_WEBHOOK_SECRET=whsec_xxxx                 # Primary webhook signing secret
STRIPE_WEBHOOK_SECRET_2=whsec_xxxx               # Secondary webhook signing secret (optional)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxxx         # Connect webhook signing secret (optional)

# ─── SendGrid (Required for emails) ───
SENDGRID_API_KEY=SG.xxxx
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=BidVex

# ─── Invoice Security ───
INVOICE_SIGNING_SECRET=your-invoice-signing-secret  # HMAC secret for signed download URLs

# ─── Emergent Integrations ───
EMERGENT_LLM_KEY=sk-emergent-xxxx                # For cloud object storage (PDF invoices)

# ─── Optional ───
FRONTEND_URL=https://yourdomain.com              # For CORS and email links
